# Matches _ignored/scripts/Pack-WarbandNexus.ps1: committed addon tree only (no externals).
# Root payload: WarbandNexus.toc (retail), WarbandNexus_Forever.toc + WarbandNexus_Camelot.toc
#   (WoW Forever, generated by scripts/build_flavor_tocs.py), Core.lua, Config.lua, embeds.xml,
#   Bindings.xml, LICENSE. One zip, one project: the packager tags it for every TOC's Interface.
#   + Modules/, Locales/, libs/, Fonts/, Media/
package-as: WarbandNexus

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  # CurseForge rejects zips with multiple addon TOCs; root embeds.xml loads libs.
  - libs/Ace3.toc
  - libs/LibDBIcon-1.0.toc
  - Locales/.locale_translate_cache.json
  - .github
  # Maintainer-only: quality gates and agent instructions are tracked in git
  # (so CI can run them) but must never reach the player zip.
  - scripts
  - docs
  - CLAUDE.md
  - .wowluarc.json

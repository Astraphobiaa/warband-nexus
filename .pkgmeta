# Matches _ignored/scripts/Pack-WarbandNexus.ps1: committed addon tree only (no externals).
# RETAIL package (tag vX.Y.Z). Root payload: WarbandNexus.toc, Core.lua, Config.lua, embeds.xml,
#   Bindings.xml, LICENSE + Modules/, Locales/, libs/, Fonts/, Media/.
# The WoW Forever package (tag forever-vX.Y.Z) uses .pkgmeta-forever, GENERATED from this file by
# scripts/build_flavor_tocs.py: the BEGIN/END retail-only block is dropped there, and it ignores
# WarbandNexus.toc + the retail-only Lua files instead.
package-as: WarbandNexus

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  # CurseForge rejects zips with multiple addon TOCs; root embeds.xml loads libs.
  - libs/Ace3.toc
  - libs/LibDBIcon-1.0.toc
  - Locales/.locale_translate_cache.json
  - .github
  # Maintainer-only: quality gates and agent instructions are tracked in git
  # (so CI can run them) but must never reach the player zip.
  - scripts
  - docs
  - CLAUDE.md
  - .wowluarc.json
  # BEGIN retail-only (WoW Forever artifacts never ship in the retail zip)
  - WarbandNexus_Forever.toc
  - WarbandNexus_Camelot.toc
  - CHANGELOG_FOREVER.md
  - .pkgmeta-forever
  # END retail-only
